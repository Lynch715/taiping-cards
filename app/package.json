{
  "name": "taiping-cards-web",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191 --strictPort",
    "build": "python3 ../tools/export_data.py --check && tsc -b && vite build && node scripts/build-pwa.mjs",
    "data": "python3 ../tools/export_data.py",
    "test": "vitest run",
    "test:golden": "vitest run tests/golden.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5192 --strictPort",
    "package:static": "npm run build && node scripts/package-static.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0",
    "vitest": "4.1.12"
  }
}
